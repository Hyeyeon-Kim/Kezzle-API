# Copy to .env and replace every replace-with-* placeholder.
# Do not add spaces around '='. Keep real secrets only in the ignored .env file.

NODE_ENV=development
PORT=3000
SHUTDOWN_DRAIN_MS=1000

MONGODB_URL=mongodb://mongodb:27017
MONGODB_DBNAME_MAIN=kezzle
MONGODB_USERNAME=
MONGODB_PASSWORD=

DEVELOPMENT_AUTH_BYPASS=false
HOME_RESILIENCE_AUTH_BYPASS=false
HOME_RESILIENCE_USER_ID=home-resilience-user
HOME_RESILIENCE_CAKE_LIKE_IDS=

FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=replace-with-client-email@example.invalid

A_BUCKET_NAME=replace-with-s3-bucket-name
A_REGION=ap-northeast-2
A_ACCESS_KEY_ID=
A_SECRET_ACCESS_KEY=

VIT_API_BASE_URL=https://api.kezzlecake.com/vit
CLIP_API_BASE_URL=https://api.kezzlecake.com/clip
AI_HTTP_TIMEOUT_MS=5000

# Remove or leave REDIS_URL empty to disable cache. Redis failure is degraded, not fatal.
REDIS_URL=redis://redis:6379
HOME_CACHE_COMMAND_TIMEOUT_MS=80
HOME_CACHE_CONNECT_TIMEOUT_MS=1000
HOME_CACHE_LOCK_TTL_MS=10000
HOME_CACHE_TTL_JITTER_PERCENT=10

HOME_HARD_DEADLINE_MS=600
HOME_RECOMMEND_TIMEOUT_MS=250
HOME_ANNIVERSARY_TIMEOUT_MS=250
HOME_POPULAR_TIMEOUT_MS=50
HOME_KEYWORD_RANKS_TIMEOUT_MS=400
HOME_NEWEST_TIMEOUT_MS=100
HOME_CURATIONS_TIMEOUT_MS=100
HOME_RESILIENCE_METRICS_ENABLED=false

HOME_CACHE_ANNIVERSARY_FRESH_TTL_MS=300000
HOME_CACHE_ANNIVERSARY_STALE_TTL_MS=1800000
HOME_CACHE_RECOMMEND_FRESH_TTL_MS=600000
HOME_CACHE_RECOMMEND_STALE_TTL_MS=3600000
HOME_CACHE_POPULAR_FRESH_TTL_MS=60000
HOME_CACHE_POPULAR_STALE_TTL_MS=600000
HOME_CACHE_KEYWORD_RANKS_FRESH_TTL_MS=60000
HOME_CACHE_KEYWORD_RANKS_STALE_TTL_MS=600000
HOME_CACHE_NEWEST_FRESH_TTL_MS=60000
HOME_CACHE_NEWEST_STALE_TTL_MS=600000
HOME_CACHE_CURATIONS_FRESH_TTL_MS=300000
HOME_CACHE_CURATIONS_STALE_TTL_MS=1800000

KEYWORD_RANK_WINDOW_DAYS=30
POPULAR_RANK_WINDOW_DAYS=30
KEYWORD_RANK_TTL_MS=600000
POPULAR_RANK_TTL_MS=600000
POPULAR_RANK_SOURCE_MAX_TIME_MS=5000

CURATION_REFRESH_INTERVAL_MS=600000
CURATION_STALE_MS=259200000
